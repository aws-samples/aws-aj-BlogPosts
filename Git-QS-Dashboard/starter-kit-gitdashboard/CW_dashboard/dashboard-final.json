    {
      "type": "log",
      "properties": {
        "query": "SOURCE '/aws/lambda/github-metrics-collector'\n| fields @timestamp, @message\n| filter @message like /Processing/\n| parse @message /Processing (?<count>\\d+) repositories/\n| stats latest(count) as RepositoryCount",
        "region": "us-east-1",
        "title": "Repository Processing Stats",
        "view": "table"
      },
      "width": 12,
      "height": 6,
      "x": 0,
      "y": 16
    },
    {
      "type": "log",
      "properties": {
        "query": "SOURCE '/aws/lambda/github-change-detector'\n| fields @timestamp, @message\n| filter @message like /Load type/\n| parse @message /Load type: (?<loadType>\\w+), Changes: (?<hasChanges>\\w+), Repos: (?<repoCount>\\d+)/\n| stats count() by loadType",
        "region": "us-east-1",
        "title": "Load Type Distribution",
        "view": "pie"
      },
      "width": 12,
      "height": 6,
      "x": 12,
      "y": 16
